// File name: projects/3/b/RAM512.hdl
/**
 * Memory of 512 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM512 {
    IN in[16], load, address[9];
    OUT out[16];

    PARTS:
    DMux8Way(in=load, sel=address[6..8],
    a=block0, b=block1, c=block2, d=block3,
    e=block4, f=block5, g=block6, h=block7);

    RAM64(in=in, load=block0, address=address[0..5], out=outblock0);
    RAM64(in=in, load=block1, address=address[0..5], out=outblock1);
    RAM64(in=in, load=block2, address=address[0..5], out=outblock2);
    RAM64(in=in, load=block3, address=address[0..5], out=outblock3);
    RAM64(in=in, load=block4, address=address[0..5], out=outblock4);
    RAM64(in=in, load=block5, address=address[0..5], out=outblock5);
    RAM64(in=in, load=block6, address=address[0..5], out=outblock6);
    RAM64(in=in, load=block7, address=address[0..5], out=outblock7);

    Mux8Way16(a=outblock0, b=outblock1, c=outblock2, d=outblock3,
    e=outblock4, f=outblock5, g=outblock6, h=outblock7,
    sel=address[6..8], out=out);
}
